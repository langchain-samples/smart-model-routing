# Copy to .env and fill in. NEVER commit .env.
# Only the keys for providers you actually route between are required.

# Weak tier (NVIDIA API catalog) — used by the server path
NVIDIA_API_KEY=

# Strong tier (Anthropic) — used by the server path
ANTHROPIC_API_KEY=

# Judge (Google Gemini) — used by the server escalation route
GOOGLE_API_KEY=

# Middleware path routes models through OpenRouter
OPENROUTER_API_KEY=

# LangSmith. Also used as the SINGLE auth key when routing models through the
# LLM Gateway (section 5 of the notebook / config/routes.gateway.toml).
# With the Gateway, provider keys live in workspace Provider Secrets, NOT here.
LANGSMITH_API_KEY_GATEWAY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financial-services-routing

# Optional: override the Gateway base URL (e.g. for BYOC: https://<host>/gateway/v1)
LANGSMITH_GATEWAY_URL=https://gateway.smith.langchain.com/v1

# Optional: override the weak/strong/judge Gateway model IDs (provider-prefixed).
# Three DISTINCT models so routing is observable and the judge != the weak tier.
WEAK_MODEL_ID=openai/gpt-5.6-luna
STRONG_MODEL_ID=openai/gpt-5.6-terra
JUDGE_MODEL_ID=openai/gpt-5.6-sol
